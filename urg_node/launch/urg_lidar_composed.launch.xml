<launch>

<!-- A launch file for testing the urg_node driver as a composable node.
     Equivalent to urg_lidar.launch.xml, but loads urg_node::UrgNode into a
     component container instead of running the standalone executable. -->

<!--  When using an IP-connected LIDAR, populate the "ip_address" argument with the address of the LIDAR.
      Otherwise, leave it blank. If supported by your LIDAR, you may enable the publish_intensity
      and/or publish_multiecho options. -->

  <arg name="ip_address" default=""/>
  <arg name="serial_port" default="/dev/ttyACM0"/>
  <arg name="serial_baud" default="115200"/>
  <arg name="frame_id" default="laser"/>
  <arg name="calibrate_time" default="true"/>
  <arg name="publish_intensity" default="false"/>
  <arg name="publish_multiecho" default="false"/>
  <arg name="angle_min" default="-1.5707963"/>
  <arg name="angle_max" default="1.5707963"/>
  <arg name="range_offset" default="0.0"/>

  <node_container pkg="rclcpp_components" exec="component_container" name="urg_container" namespace="">
    <composable_node pkg="urg_node" plugin="urg_node::UrgNode" name="urg_node" namespace="">
      <param name="ip_address" value="$(var ip_address)"/>
      <param name="serial_port" value="$(var serial_port)"/>
      <param name="serial_baud" value="$(var serial_baud)"/>
      <param name="frame_id" value="$(var frame_id)"/>
      <param name="calibrate_time" value="$(var calibrate_time)"/>
      <param name="publish_intensity" value="$(var publish_intensity)"/>
      <param name="publish_multiecho" value="$(var publish_multiecho)"/>
      <param name="angle_min" value="$(var angle_min)"/>
      <param name="angle_max" value="$(var angle_max)"/>
      <param name="range_offset" value="$(var range_offset)"/>
    </composable_node>
  </node_container>

</launch>
